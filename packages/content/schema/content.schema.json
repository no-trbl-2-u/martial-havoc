            "$ref": "#/$defs/atoms/twoD6"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "encounterCell": {
        "description": "One cell of the Encounters matrix (MH p.67, R74): a 2d6 total in one of the five columns. `printed` is the cell verbatim; `opponentRef` is the canonical opponent id it resolves to, or null when the cell redirects to another column instead of naming an opponent.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "total",
          "column",
          "printed",
          "opponentRef",
          "redirectColumn"
        ],
