      "healing": {
        "description": "One row of the healing summary (MH p.31, R40-R42): what partially restores an attribute, by how much, and what fully restores it. LUCK has no full-restore rule, so `full` is null.",
        "type": "object",
        "additionalProperties": false,
        "required": [
