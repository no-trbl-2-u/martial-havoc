            "type": "string",
            "minLength": 1
          },
          "printed": {
            "type": "string",
            "minLength": 1
          },
          "opponentRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "redirectColumn": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "columnCell": {
        "description": "One cell of a d6-per-column table: the Region table (MH p.43) and the Monastery table (MH p.45). Roll one d6 for each column you need.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "column",
          "face",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
