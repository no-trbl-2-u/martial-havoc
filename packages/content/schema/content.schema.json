{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://martial-havoc.no-trbl-2-u.workers.dev/schema/content.schema.json",
  "title": "Martial Havoc content file",
  "description": "The one schema every data file in packages/content/data validates against. A file is an envelope (id, kind, title, cite, label, docs) wrapping an array of records. `kind` names the shape of the table's dice address; the top-level oneOf switches on it, and each branch fixes exactly which record shapes that kind may hold. Every object is closed (additionalProperties: false) so a stray or misspelled field is red, and every record carries `id` and `cite` so nothing ships without a folio. Phase 5's adventure files reuse these same kinds, which is what keeps `one schema` true.",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/files/d6-banded"
    },
    {
      "$ref": "#/$defs/files/d66"
    },
    {
      "$ref": "#/$defs/files/1d6"
    },
    {
      "$ref": "#/$defs/files/2d6"
    },
    {
      "$ref": "#/$defs/files/2d6-by-column"
    },
    {
      "$ref": "#/$defs/files/d6-by-column"
    },
    {
      "$ref": "#/$defs/files/list"
    },
    {
      "$ref": "#/$defs/files/presets"
    },
    {
      "$ref": "#/$defs/files/strings"
    }
  ],
  "$defs": {
    "atoms": {
      "id": {
        "description": "Dotted kebab-case identifier, unique across the whole package (e.g. `technique.iron-head`). The d66 or the band is a field, never part of the id.",
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
      },
      "cite": {
        "description": "Where the record comes from: a folio (`MH p.12`), an inventory id (`I-04`), or a repo path.",
        "type": "string",
        "minLength": 1
      },
      "label": {
        "description": "The spec's three labels. Every table transcribed from the book is `rule`.",
        "enum": [
          "rule",
          "reading",
          "invention"
        ]
      },
      "reading": {
        "description": "An inventory reading id, carried IN ADDITION to the record's own fields when a cell is inferred rather than printed. Never instead of `cite`.",
        "type": "string",
        "pattern": "^I-[0-9]{2}[a-z]?$"
      },
      "band": {
        "description": "A banded d6 address as printed: the first die's range (`1-2`, `3-4`, `5-6`, or `1-3`, `4-6`).",
        "type": "string",
        "pattern": "^[1-6]-[1-6]$"
      },
      "die": {
        "description": "One d6 face.",
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "d66": {
        "description": "A d66 address: tens die then ones die, read as a two-digit number (11..66; every digit is 1-6, which the content test asserts).",
        "type": "integer",
        "minimum": 11,
        "maximum": 66
      },
      "twoD6": {
        "description": "A 2d6 total.",
        "type": "integer",
        "minimum": 2,
        "maximum": 12
      },
      "faces": {
        "description": "The d6 faces a banded row covers, listed explicitly so the engine never parses a range string.",
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "$ref": "#/$defs/atoms/die"
        }
      },
      "diceSpec": {
        "description": "A dice expression as data: `n` dice of `d` faces plus `plus`. `n: 0` means no dice at all, so a fixed amount (Vagabond's 1 GP) needs no second shape and no branch in the engine.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "d",
          "plus"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "d": {
            "type": "integer",
            "minimum": 2
          },
          "plus": {
            "type": "integer"
          }
        }
      },
      "namedValue": {
        "description": "A Proficiency (or Technique/Ritual) name with the value printed beside it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "integer"
          }
        }
      }
    },
    "records": {
      "martialArt": {
        "description": "One of the 18 Martial Arts (MH p.7-10), banded d6 x d6. `power` is the style text's own power where the style carries one (R13), verbatim, else null.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "band",
          "row",
          "name",
          "styleText",
          "proficiencies",
          "power",
          "powerClass"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "band": {
            "$ref": "#/$defs/atoms/band"
          },
          "faces": {
            "$ref": "#/$defs/atoms/faces"
          },
          "row": {
            "$ref": "#/$defs/atoms/die"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "styleText": {
            "type": "string",
            "minLength": 1
          },
          "proficiencies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "power": {
            "type": [
              "string",
              "null"
            ]
          },
          "powerClass": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "deity": {
        "description": "One of the 12 Deities (MH p.29), banded d6 x d6; three columns combine into a name.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "band",
          "row",
          "name",
          "action",
          "object"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "band": {
            "$ref": "#/$defs/atoms/band"
          },
          "faces": {
            "$ref": "#/$defs/atoms/faces"
          },
          "row": {
            "$ref": "#/$defs/atoms/die"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "object": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "finalBlow": {
        "description": "One of the 18 Final Blow inspiration rows (MH p.26), banded d6 x d6: an action, an attribute and an animal to name a landed blow (R31).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "band",
          "row",
          "action",
          "attribute",
          "animal"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "band": {
            "$ref": "#/$defs/atoms/band"
          },
          "faces": {
            "$ref": "#/$defs/atoms/faces"
          },
          "row": {
            "$ref": "#/$defs/atoms/die"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "attribute": {
            "type": "string",
            "minLength": 1
          },
          "animal": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "cityEncounter": {
        "description": "One of the 12 city-encounter rows (MH p.51), banded d6 x d6: how the person you already know is connected to you, and one trait.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "band",
          "row",
          "connection",
          "trait"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "band": {
            "$ref": "#/$defs/atoms/band"
          },
          "faces": {
            "$ref": "#/$defs/atoms/faces"
          },
          "row": {
            "$ref": "#/$defs/atoms/die"
          },
          "connection": {
            "type": "string",
            "minLength": 1
          },
          "trait": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "learnable": {
        "description": "A Technique (MH p.12-15) or a Ritual (MH p.16-19) on its d66 address. `cost` is both the Resource points to learn (R16) and the ENDURANCE to perform (R18). `effect` and `pinyin` are verbatim, non-standard spellings included.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "d66",
          "name",
          "pinyin",
          "cost",
          "effect"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "d66": {
            "$ref": "#/$defs/atoms/d66"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "pinyin": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "effect": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "d66Text": {
        "description": "A d66 row whose whole content is one passage of text (the 36 adventure hooks, MH p.36-39).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "d66",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "d66": {
            "$ref": "#/$defs/atoms/d66"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "word": {
        "description": "One word cell of a d66 word table: the two Inspirations tables (MH p.59-60, `table` is `action` or `theme`) and the six Sparks tables (MH p.60-63, `table` is `1`..`6`).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "table",
          "d66",
          "word"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "d66": {
            "$ref": "#/$defs/atoms/d66"
          },
          "word": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "socialStatus": {
        "description": "One of the 5 social-status bands (MH p.5, R03): the faces that land on it, the status name, and the gold it starts you with as a dice spec.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "faces",
          "status",
          "goldDice"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "faces": {
            "$ref": "#/$defs/atoms/faces"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "goldDice": {
            "$ref": "#/$defs/atoms/diceSpec"
          }
        }
      },
      "treasure": {
        "description": "One cell of the Treasure table (MH p.68, R78): 1d6 down the side, the defeated opponent's ENDURANCE band across the top.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "face",
          "band",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "face": {
            "$ref": "#/$defs/atoms/die"
          },
          "band": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "unexpectedEvent": {
        "description": "One row of the Unexpected Event table (MH p.28, R32). `retreatRow` marks the two Enemy-retreat rows: the sealed Morale reading lives on them and reopens only through /re-seed.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "total",
          "text",
          "retreatRow"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
          "total": {
            "$ref": "#/$defs/atoms/twoD6"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "retreatRow": {
            "type": "boolean"
          }
        }
      },
      "specialItem": {
        "description": "One row of the Special Items table (MH p.69, R79), 2d6. `effect` is verbatim, lower-case openings included.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "total",
          "name",
          "effect"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/atoms/id"
          },
          "cite": {
            "$ref": "#/$defs/atoms/cite"
          },
          "reading": {
            "$ref": "#/$defs/atoms/reading"
          },
