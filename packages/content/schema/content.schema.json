            "type": "string",
            "minLength": 1
          }
        }
      },
      "oracleCell": {
        "description": "One cell of the Oracle (MH p.58, R71): 11 named rows, one d6 across. `spanInferred` is true where the printed cell is centred under two or more faces and the estate inferred the span; the text is the same in every face of that span.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "row",
          "face",
          "text",
          "spanInferred"
        ],
