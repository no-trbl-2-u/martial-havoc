              "enum": [
                "weapon",
                "alcohol",
                "underTwentyGp"
              ]
            },
            "uniqueItems": true
          }
        }
      },
      "cityService": {
        "description": "One line of the City Services price list (MH p.50, R64). The price is kept verbatim because the list prices per question, per dose, per day and per km, and one line is a range (`50-200 GP`) and one is `free offering`.",
