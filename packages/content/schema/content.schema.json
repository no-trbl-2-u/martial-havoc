            "type": "string",
            "minLength": 1
          },
          "spanInferred": {
            "type": "boolean"
          }
        }
      },
      "opponent": {
        "description": "One of the 50 opponent stat blocks (MH p.70-79, R80). `attack` is printed as an integer, as the range `2-4` (Brawler), or blank (Huang Feng Guai) - kept as printed rather than normalised. `martialArtsValue` carries the n of a `Martial Arts (n)` Proficiency (R75); the Proficiency itself stays in the list.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "name",
          "description",
          "skill",
          "endurance",
          "attack",
          "proficiencies",
          "martialArtsValue",
          "page",
          "notes"
