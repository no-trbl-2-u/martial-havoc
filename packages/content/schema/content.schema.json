      "marketItem": {
        "description": "One priced line of the four Market lists (MH p.52-55). Exactly one of `priceGp` / `priceSp` is set, as printed. `flags` is computed at data time and read (never recomputed) by the engine: `weapon` (R68, I-02), `underTwentyGp` (the starting-kit cap of R02), `alcohol` (I-03).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cite",
          "list",
          "item",
          "priceGp",
          "priceSp",
          "flags"
        ],
